# Copy this file to .env and adjust values for the local or Docker runtime.
# Empty or omitted application values use the built-in fallback.

# Official National Bank page where the user downloads the annual-rate XLSX.
KZ_TAX_REPORT_NBK_DOWNLOAD_URL=https://nationalbank.kz/ru/news/oficialnye-kursy
KZ_TAX_REPORT_IBKR_REPORTS_URL=https://www.interactivebrokers.co.uk/AccountManagement/AmAuthentication?action=TaxReports
KZ_TAX_REPORT_FREEDOM_REPORTS_URL=https://support.bankffin.kz/deklarirovanie-valyuty-freedom

# Directory containing approved tax_rules_<year>.yaml files.
# Leave empty to use the bundled rules next to the Python package.
KZ_TAX_REPORT_RULES_DIR=

# Host directories mounted by Docker Compose.
INPUTS_HOST_DIR=./data
OUTPUT_HOST_DIR=./output

# UI-generated local copies are written here inside the container. In the
# local web Compose profile this is bind-mounted from OUTPUT_HOST_DIR.
KZ_TAX_REPORT_OUTPUT_DIR=/outputs

# Browser artifact policy. Jobs are opaque, private directories cleaned by TTL.
KZ_TAX_REPORT_ARTIFACT_DIR=/tmp/kz-tax-report-jobs
KZ_TAX_REPORT_ARTIFACT_MODE=local
KZ_TAX_REPORT_ARTIFACT_TTL_SECONDS=2592000
KZ_TAX_REPORT_MAX_UPLOAD_BYTES=26214400
KZ_TAX_REPORT_MAX_JOB_BYTES=78643200

# Hosted mode is opt-in and fails closed unless every value below is set.
# Cloudflare Access must be the only public ingress; the Compose hosted profile
# binds the origin to loopback for a tunnel or equivalent reverse proxy.
KZ_TAX_REPORT_MODE=local
KZ_TAX_REPORT_ACCESS_ISSUER=
KZ_TAX_REPORT_ACCESS_AUDIENCE=
KZ_TAX_REPORT_ACCESS_JWKS_URL=
KZ_TAX_REPORT_SESSION_SECRET=
KZ_TAX_REPORT_PUBLIC_URL=https://tax.example.test
KZ_TAX_REPORT_TRUST_PROXY=false
